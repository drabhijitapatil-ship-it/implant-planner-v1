{
  "expo": {
    "name": "Implanr",
    "slug": "implanr",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "implanr",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.2.4",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/421ba752-d276-4e5d-9496-66d13cd3d6a0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.implanr.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "26"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.implanr.app",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "versionCode": 27
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2196F3"
        }
      ],
      "./plugins/withAndroidNetworkConfig",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photo library to upload radiographs and clinical images.",
          "cameraPermission": "Allow access to your camera to capture radiographs and clinical images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "421ba752-d276-4e5d-9496-66d13cd3d6a0"
      },
      "router": {},
      "backendUrl": ""
    },
    "owner": "abhijitapatil"
  }
}
